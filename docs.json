{
  "theme": "palm",
  "name": "Quidax Documentation",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "logo": {
    "light": "/images/light-log.svg",
    "dark": "/images/dark-logo.svg"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "strict": false
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#17151B"
    }
  },
  "navbar": {
    "links": [
      {
        "href": "mailto:hi@mintlify.com",
        "label": "Support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://www.linkedin.com/company/quidax"
    }
  },
  "fonts": {
    "family": "Open Sans"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ],
    "display": "header"
